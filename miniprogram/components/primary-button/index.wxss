@import "../../styles/layout.wxss";
@import "../../styles/page.wxss";

.button-outer {
  min-height: var(--height-button-large);
  padding: 0 var(--space-page-x);
  border: 0;
  border-radius: var(--radius-pill);
  background: var(--gradient-brand-button);
  color: var(--color-text-inverse);
  box-shadow: var(--shadow-button);
  box-sizing: border-box;
  line-height: 1.35;
}

.button-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.button-text {
  color: var(--color-text-inverse);
  font-size: var(--font-size-xl);
  font-weight: 700;
  line-height: 1.35;
}

.button-subtext {
  color: var(--color-text-inverse-muted);
  font-size: var(--font-size-xs);
  line-height: 1.35;
}

.button-size-large {
  min-height: var(--height-button-large);
  font-size: var(--font-size-lg);
}

.button-size-medium {
  min-height: var(--height-button-medium);
  font-size: var(--font-size-md);
}

.button-size-medium .button-text {
  font-size: var(--font-size-lg);
}

.button-size-small {
  min-height: var(--height-button-small);
  padding: 0 var(--space-md);
  font-size: var(--font-size-sm);
}

.button-size-small .button-text {
  font-size: var(--font-size-sm);
}

.button-size-small .button-subtext {
  display: none;
}

.button-tone-brand {
  background: var(--gradient-brand-button);
}

.button-tone-success {
  background: var(--color-success);
  box-shadow: 0 14rpx 28rpx rgba(93, 150, 100, 0.2);
}

.button-tone-danger {
  background: var(--color-danger);
  box-shadow: 0 14rpx 28rpx rgba(198, 105, 87, 0.18);
}

.is-block {
  width: 100%;
}

.is-inline {
  width: auto;
  min-width: 176rpx;
}

.is-disabled {
  opacity: 0.45;
  box-shadow: none;
}

.is-loading {
  opacity: 0.72;
}

.button-hover {
  opacity: 0.88;
}
