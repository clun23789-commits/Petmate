@import "../../../styles/layout.wxss";
@import "../../../styles/page.wxss";

.share-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 0%, rgba(255, 239, 213, 0.72), rgba(255, 239, 213, 0) 36%),
    linear-gradient(180deg, #fffaf3 0%, #fff7ed 100%);
  color: #2f2923;
  box-sizing: border-box;
}

.share-page button::after {
  border: none;
}

.share-content,
.invalid-wrap,
.loading-wrap {
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.loading-wrap {
  padding: 80rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.loading-card,
.error-card {
  min-height: 360rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(235, 221, 202, 0.9);
  box-shadow: 0 14rpx 38rpx rgba(72, 48, 29, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 48rpx 36rpx;
  box-sizing: border-box;
  text-align: center;
}

.loading-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(244, 124, 31, 0.2);
  border-top-color: #f47c1f;
}

.loading-title,
.error-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2f2923;
  line-height: 1.35;
}

.loading-desc,
.error-desc {
  font-size: 24rpx;
  color: #7a6d5f;
  line-height: 1.5;
}

.hero-card {
  position: relative;
  margin: 20rpx 28rpx 0;
  min-height: 760rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #f2dfc7;
  box-shadow: 0 20rpx 60rpx rgba(82, 56, 34, 0.12);
}

.hero-image {
  width: 100%;
  height: 760rpx;
  display: block;
}

.image-fallback {
  width: 100%;
  height: 760rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: linear-gradient(135deg, #f4e4cf 0%, #fff4e6 100%);
  color: #756655;
  text-align: center;
  box-sizing: border-box;
  padding: 48rpx;
}

.image-fallback-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #4a3c30;
  line-height: 1.35;
}

.image-fallback-desc {
  font-size: 24rpx;
  color: #8a7a68;
  line-height: 1.5;
}

.preview-badge {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #2f3328;
  font-size: 24rpx;
  font-weight: 700;
}

.preview-badge-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #5f9b59;
  color: #ffffff;
  text-align: center;
  line-height: 28rpx;
  font-size: 18rpx;
}

.preview-badge-text {
  line-height: 1.2;
}

.owner-card {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: rgba(255, 255, 255, 0.94);
}

.share-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.share-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2f2923;
  line-height: 1.32;
}

.pet-name {
  align-self: flex-start;
  max-width: 100%;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1d8;
  color: #9a5d18;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  box-sizing: border-box;
}

.share-description {
  font-size: 26rpx;
  color: #6d6256;
  line-height: 1.55;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.share-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f6f0e6;
  color: #7b6a59;
  font-size: 22rpx;
  line-height: 1.35;
}

.owner-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.owner-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
  flex-shrink: 0;
}

.owner-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.owner-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2f2923;
  line-height: 1.24;
}

.owner-summary {
  font-size: 24rpx;
  color: #6d6256;
  line-height: 1.45;
}

.enter-link {
  flex-shrink: 0;
  min-width: 150rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(220, 207, 190, 0.9);
  color: #3d332b;
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.feature-row {
  display: flex;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(210, 190, 164, 0.5);
}

.feature-item {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  text-align: center;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.feature-divider {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  right: 0;
  width: 1rpx;
  background: rgba(210, 190, 164, 0.52);
}

.feature-icon {
  font-size: 30rpx;
  color: #b88d5c;
  line-height: 1;
}

.feature-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #3b332b;
  line-height: 1.4;
}

.feature-desc {
  font-size: 22rpx;
  color: #8a7a68;
  line-height: 1.4;
}

.official-banner,
.action-card {
  margin: 24rpx 28rpx 0;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.official-banner {
  min-height: 110rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: linear-gradient(90deg, #eef6df 0%, #f6f0dd 100%);
}

.banner-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(96, 145, 84, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5f8d54;
  flex-shrink: 0;
  font-size: 28rpx;
}

.banner-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #5b8c4a;
  line-height: 1.3;
}

.banner-desc {
  font-size: 24rpx;
  color: #6f7b5e;
  line-height: 1.4;
}

.banner-illustration {
  font-size: 44rpx;
  line-height: 1;
}

.action-card {
  min-height: 136rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(235, 221, 202, 0.9);
  box-shadow: 0 14rpx 38rpx rgba(72, 48, 29, 0.06);
}

.start-action {
  min-height: 158rpx;
  background: linear-gradient(135deg, #fff8ef 0%, #fff2df 100%);
}

.action-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eef5e8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #6a985a;
  font-size: 30rpx;
}

.action-icon-warm {
  background: #fff1d8;
  color: #f28a23;
}

.action-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2f2923;
  line-height: 1.3;
}

.action-desc {
  font-size: 24rpx;
  line-height: 1.45;
  color: #7a6d5f;
}

.primary-pill,
.outline-pill,
.light-pill {
  margin: 0;
  padding: 0 24rpx;
  min-width: 164rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
  flex-shrink: 0;
}

.primary-pill {
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a2e 0%, #f47c1f 100%);
  box-shadow: 0 12rpx 28rpx rgba(244, 124, 31, 0.24);
}

.outline-pill {
  color: #5b8c4a;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(91, 140, 74, 0.45);
}

.light-pill {
  color: #3d332b;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(220, 207, 190, 0.9);
}

.safe-footer {
  padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.safe-footer-text {
  color: #8c8b82;
  font-size: 24rpx;
  line-height: 1.6;
}

.invalid-wrap {
  padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.error-card {
  margin-top: 24rpx;
}

.error-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fff1d8;
  color: #f47c1f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
}

.error-button {
  margin-top: 10rpx;
  min-width: 220rpx;
}

.error-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
