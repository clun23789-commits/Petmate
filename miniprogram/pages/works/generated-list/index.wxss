@import "../../../styles/tokens.wxss";
@import "../../../styles/layout.wxss";
@import "../../../styles/page.wxss";

.generated-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.rights-banner,
.filter-empty-card,
.more-card,
.work-card {
  background: rgba(255, 253, 248, 0.95);
  border: 1rpx solid rgba(234, 220, 203, 0.84);
  box-shadow: var(--shadow-soft);
  box-sizing: border-box;
}

.rights-banner {
  min-height: 84rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(231, 244, 232, 0.92);
  border-color: rgba(93, 150, 100, 0.16);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rights-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: var(--success);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
  flex-shrink: 0;
}

.rights-text {
  flex: 1;
  min-width: 0;
  color: var(--success-strong);
  font-size: 25rpx;
  line-height: 1.45;
}

.rights-arrow {
  color: var(--success-strong);
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}

.content-stack {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.toolbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.filter-tabs {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  background: rgba(255, 250, 243, 0.76);
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  overflow: hidden;
}

.filter-tab {
  flex: 1;
  min-width: 0;
  min-height: 66rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-primary);
  font-size: 26rpx;
  box-sizing: border-box;
}

.filter-tab + .filter-tab {
  border-left: 1rpx solid rgba(234, 220, 203, 0.72);
}

.filter-tab.is-active {
  background: #ffffff;
  color: var(--brand);
  font-weight: 700;
  border: 1rpx solid rgba(241, 138, 49, 0.24);
  border-radius: 18rpx;
  margin: 2rpx;
}

.sort-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.sort-pill,
.list-icon {
  height: 66rpx;
  border-radius: 18rpx;
  background: rgba(255, 250, 243, 0.82);
  border: 1rpx solid var(--border);
  box-sizing: border-box;
}

.sort-pill {
  min-width: 136rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-primary);
  font-size: 26rpx;
}

.list-icon {
  width: 66rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.list-line {
  width: 24rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(105, 91, 76, 0.76);
}

.list-heading {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.list-title {
  font-size: 34rpx;
  line-height: 1.32;
  font-weight: 700;
  color: var(--text-primary);
}

.list-count {
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-secondary);
}

.work-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.work-card {
  display: flex;
  gap: 22rpx;
  padding: 20rpx;
  border-radius: 28rpx;
}

.work-card.tone-warning {
  border-color: rgba(183, 204, 238, 0.8);
}

.work-card.tone-danger {
  border-color: rgba(238, 204, 198, 0.86);
}

.work-cover {
  width: 152rpx;
  height: 152rpx;
  border-radius: 22rpx;
  background: #f5ecdf;
  flex-shrink: 0;
}

.work-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.work-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.name-row,
.right-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.name-row {
  flex: 1;
}

.work-name {
  min-width: 0;
  font-size: 38rpx;
  line-height: 1.24;
  font-weight: 700;
  color: var(--text-primary);
}

.edit-icon {
  color: rgba(153, 120, 82, 0.9);
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}

.ar-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  white-space: nowrap;
  flex-shrink: 0;
}

.ar-badge-owned {
  color: var(--brand-strong);
  background: rgba(255, 247, 236, 0.96);
  border: 1rpx solid rgba(241, 138, 49, 0.34);
}

.ar-badge-unpaid {
  color: var(--text-secondary);
  background: rgba(250, 247, 242, 0.96);
  border: 1rpx solid rgba(220, 210, 198, 0.9);
}

.ar-badge-pending {
  color: #6a7a4e;
  background: rgba(242, 248, 234, 0.96);
  border: 1rpx solid rgba(170, 194, 129, 0.42);
}

.chevron {
  color: rgba(140, 128, 112, 0.74);
  font-size: 44rpx;
  line-height: 1;
  flex-shrink: 0;
}

.work-time {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.status-pill {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 600;
}

.status-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.72);
}

.status-success {
  background: var(--success-soft);
  color: var(--success-strong);
}

.status-warning {
  background: rgba(234, 241, 255, 0.98);
  color: #3f6faf;
}

.status-danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.status-neutral {
  background: rgba(242, 235, 226, 0.98);
  color: var(--text-secondary);
}

.work-hint {
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.action-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx 0;
  color: var(--text-secondary);
  font-size: 23rpx;
}

.action-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 14rpx;
  border-right: 1rpx solid rgba(155, 139, 124, 0.2);
}

.action-item:first-child {
  padding-left: 0;
}

.action-item-share {
  border-right: none;
}

.action-item-share.is-preparing {
  color: var(--brand-strong);
}

button.share-send-button {
  margin: 0;
  padding: 0 14rpx;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
  color: var(--brand-strong);
  font-size: 23rpx;
  font-weight: 600;
}

button.share-send-button::after {
  border: none;
}

.share-send-button {
  border-right: none;
  padding-right: 0;
}

.action-symbol {
  font-size: 22rpx;
  line-height: 1;
  color: rgba(109, 95, 82, 0.86);
}

.regenerate-button,
.filter-empty-button,
.more-start-button {
  margin: 0;
  padding: 0 30rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 700;
}

.regenerate-button::after,
.filter-empty-button::after,
.more-start-button::after {
  border: none;
}

.regenerate-button {
  align-self: flex-end;
  margin-top: 8rpx;
  background: rgba(255, 252, 248, 0.98);
  color: var(--brand-strong);
  border: 1rpx solid rgba(241, 138, 49, 0.44);
}

.filter-empty-card {
  padding: 34rpx 28rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  text-align: center;
}

.filter-empty-badge {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: rgba(241, 138, 49, 0.12);
  color: var(--brand-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
}

.filter-empty-title {
  font-size: 30rpx;
  line-height: 1.34;
  font-weight: 700;
  color: var(--text-primary);
}

.filter-empty-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.filter-empty-button {
  margin-top: 6rpx;
  background: linear-gradient(180deg, #ff9b3f 0%, #f47c1d 100%);
  color: #fff;
  box-shadow: 0 14rpx 28rpx rgba(241, 138, 49, 0.24);
}

.more-card {
  position: relative;
  padding: 24rpx 24rpx 24rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.more-visual {
  position: relative;
  width: 132rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.more-box {
  position: absolute;
  left: 16rpx;
  right: 10rpx;
  bottom: 8rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f3ddbb 0%, #ebc995 100%);
  box-shadow: inset 0 6rpx 14rpx rgba(255, 255, 255, 0.42);
}

.more-box::before,
.more-box::after {
  content: "";
  position: absolute;
  top: -18rpx;
  width: 44rpx;
  height: 26rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: #f1d5aa;
}

.more-box::before {
  left: 0;
  transform: rotate(-12deg);
}

.more-box::after {
  right: 0;
  transform: rotate(12deg);
}

.more-pet {
  position: absolute;
  left: 12rpx;
  bottom: 14rpx;
  width: 104rpx;
  height: 104rpx;
}

.more-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.more-title {
  font-size: 38rpx;
  line-height: 1.24;
  font-weight: 700;
  color: var(--text-primary);
}

.more-desc {
  font-size: 24rpx;
  line-height: 1.58;
  color: var(--text-secondary);
}

.more-start-button {
  flex-shrink: 0;
  background: linear-gradient(180deg, #ff9b3f 0%, #f47c1d 100%);
  color: #fff;
  box-shadow: 0 14rpx 28rpx rgba(241, 138, 49, 0.24);
}

.bottom-note {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 2rpx 6rpx 8rpx;
}

.note-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: rgba(255, 235, 202, 0.94);
  color: #c58a2b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
  flex-shrink: 0;
}

.note-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.56;
  color: rgba(112, 96, 79, 0.88);
}
