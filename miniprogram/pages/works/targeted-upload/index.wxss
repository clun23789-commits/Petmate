@import "../../../styles/tokens.wxss";
@import "../../../styles/layout.wxss";
@import "../../../styles/page.wxss";

.targeted-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: 28rpx;
}

.targeted-notice-card,
.target-card,
.existing-assets-card,
.suggest-assets-card,
.supplement-preview-card,
.quota-safe-card,
.debug-card {
  border-radius: 32rpx;
  box-sizing: border-box;
}

.target-card,
.existing-assets-card,
.suggest-assets-card,
.supplement-preview-card,
.quota-safe-card {
  padding: 26rpx;
  background: rgba(255, 253, 248, 0.98);
  border: 1rpx solid rgba(234, 220, 203, 0.9);
  box-shadow: 0 14rpx 34rpx rgba(95, 72, 48, 0.07);
}

.targeted-notice-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(255, 244, 220, 0.95), rgba(255, 249, 238, 0.98));
  border: 1rpx solid rgba(241, 138, 49, 0.14);
  box-shadow: 0 12rpx 28rpx rgba(124, 97, 62, 0.06);
}

.notice-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffd66d, #f5ad35);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 700;
  flex-shrink: 0;
}

.notice-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.notice-line {
  font-size: 28rpx;
  line-height: 1.58;
  color: var(--text-primary);
}

.notice-emphasis {
  color: var(--color-brand);
  font-weight: 700;
}

.card-title-row,
.card-header-row,
.available-badge,
.target-problem-line,
.existing-meta-row,
.suggest-tip-row,
.supplement-item,
.bottom-action-panel,
.action-source-button,
.source-copy,
.quota-safe-card,
.supplement-copy,
.debug-card {
  display: flex;
}

.card-title-row {
  align-items: center;
  gap: 14rpx;
}

.card-header-row {
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
  flex-shrink: 0;
}

.target-icon {
  background: rgba(255, 168, 86, 0.18);
  color: var(--color-brand);
}

.image-icon {
  background: rgba(47, 38, 31, 0.08);
  color: var(--text-primary);
}

.suggest-icon {
  background: rgba(255, 168, 86, 0.18);
  color: var(--color-brand);
}

.supplement-icon {
  background: rgba(118, 166, 79, 0.18);
  color: #5d8f47;
}

.card-title {
  font-size: 32rpx;
  line-height: 1.36;
  font-weight: 700;
  color: var(--text-primary);
}

.target-content-row {
  margin-top: 22rpx;
  display: flex;
  align-items: stretch;
  gap: 18rpx;
}

.target-copy-box {
  flex: 1;
  min-height: 140rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff8ee, #fffdf8);
  border: 1rpx solid rgba(234, 220, 203, 0.7);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 18rpx;
  min-width: 0;
}

.target-label,
.target-suggest {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-primary);
}

.target-problem {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-brand);
  font-weight: 700;
}

.target-pet-image {
  width: 164rpx;
  height: 164rpx;
  border-radius: 24rpx;
  background: #f7eadb;
  flex-shrink: 0;
}

.available-badge {
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.available-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: rgba(124, 176, 106, 0.16);
  color: #6fa05b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
}

.available-text {
  font-size: 26rpx;
  line-height: 1.4;
  color: #6fa05b;
}

.existing-scroll,
.suggest-scroll {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.existing-row,
.suggest-row {
  display: inline-flex;
  gap: 18rpx;
}

.existing-item,
.existing-view-all {
  width: 164rpx;
  flex-shrink: 0;
}

.existing-image {
  width: 164rpx;
  height: 142rpx;
  border-radius: 20rpx;
  background: #f7eadb;
}

.existing-meta-row {
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 14rpx;
}

.small-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: rgba(124, 176, 106, 0.16);
  color: #6fa05b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 700;
  flex-shrink: 0;
}

.existing-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.existing-title {
  font-size: 28rpx;
  line-height: 1.36;
  font-weight: 600;
  color: var(--text-primary);
}

.existing-status {
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-secondary);
}

.existing-view-all {
  height: 220rpx;
  border-radius: 22rpx;
  border: 2rpx dashed rgba(155, 139, 124, 0.34);
  color: var(--text-secondary);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.view-all-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: rgba(47, 38, 31, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
  color: var(--text-secondary);
}

.view-all-text {
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--text-secondary);
}

.suggest-item {
  position: relative;
  width: 206rpx;
  min-height: 252rpx;
  padding: 22rpx 18rpx 20rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(234, 220, 203, 0.82);
  background: linear-gradient(180deg, rgba(255, 253, 249, 0.98), rgba(255, 250, 242, 0.96));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.suggest-item.is-recommended {
  border-color: rgba(241, 138, 49, 0.72);
  box-shadow: 0 12rpx 26rpx rgba(241, 138, 49, 0.12);
}

.recommend-tag {
  position: absolute;
  top: 0;
  left: 0;
  padding: 10rpx 18rpx;
  border-radius: 24rpx 0 18rpx 0;
  background: linear-gradient(180deg, #ffad42, #ff8a22);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}

.suggest-item-image {
  width: 124rpx;
  height: 124rpx;
  margin-top: 10rpx;
  opacity: 0.18;
}

.suggest-item-title {
  font-size: 30rpx;
  line-height: 1.34;
  text-align: center;
  color: var(--text-primary);
}

.suggest-item-desc {
  font-size: 24rpx;
  line-height: 1.36;
  color: var(--text-secondary);
  text-align: center;
}

.suggest-tip-row {
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
}

.suggest-tip-icon {
  width: 38rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: rgba(255, 168, 86, 0.16);
  color: var(--color-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
  flex-shrink: 0;
}

.suggest-tip-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.58;
  color: var(--text-secondary);
}

.supplement-preview-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.preview-status {
  font-size: 24rpx;
  line-height: 1.36;
  color: #6fa05b;
}

.supplement-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.supplement-item {
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 248, 240, 0.94);
}

.supplement-image {
  width: 122rpx;
  height: 122rpx;
  border-radius: 20rpx;
  background: #f7eadb;
  flex-shrink: 0;
}

.supplement-copy {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.supplement-title {
  font-size: 28rpx;
  line-height: 1.36;
  font-weight: 600;
  color: var(--text-primary);
}

.supplement-status {
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-secondary);
}

.supplement-remove {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  color: var(--color-brand);
  background: rgba(255, 141, 77, 0.12);
  font-size: 24rpx;
  line-height: 1;
  flex-shrink: 0;
}

.supplement-hint {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: var(--text-secondary);
}

.bottom-action-panel {
  align-items: stretch;
  gap: 16rpx;
}

.action-source-button {
  width: 168rpx;
  min-height: 136rpx;
  padding: 22rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.98);
  border: 1rpx solid rgba(234, 220, 203, 0.9);
  box-shadow: 0 12rpx 28rpx rgba(95, 72, 48, 0.06);
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.source-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: rgba(47, 38, 31, 0.08);
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
}

.source-copy {
  flex-direction: column;
  gap: 6rpx;
}

.source-title {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
  color: var(--text-primary);
}

.source-subtitle {
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-secondary);
}

.confirm-optimize-button {
  flex: 1;
  min-height: 136rpx;
  margin: 0;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  border: none;
  background: linear-gradient(180deg, #ff9d33, #ff7e18);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 16rpx 32rpx rgba(255, 126, 24, 0.24);
}

.confirm-optimize-button::after {
  border: none;
}

.confirm-optimize-button.is-disabled {
  background: linear-gradient(180deg, rgba(255, 190, 136, 0.92), rgba(255, 178, 115, 0.92));
  box-shadow: none;
}

.confirm-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: inherit;
}

.confirm-subtitle {
  font-size: 22rpx;
  line-height: 1.45;
  color: inherit;
  opacity: 0.88;
}

.quota-safe-card {
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(180deg, rgba(241, 249, 239, 0.98), rgba(231, 244, 226, 0.98));
  border-color: rgba(148, 193, 128, 0.28);
}

.quota-check,
.quota-info {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.quota-check {
  background: rgba(118, 166, 79, 0.16);
  color: #5d8f47;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
}

.quota-info {
  border: 2rpx solid #7aac62;
  color: #7aac62;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}

.quota-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.58;
  color: #4f6f3f;
}

.debug-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.debug-card {
  padding: 24rpx;
  background: rgba(255, 252, 247, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(124, 97, 62, 0.08);
  flex-direction: column;
  gap: 8rpx;
}

.debug-card-wide {
  grid-column: span 2;
}
