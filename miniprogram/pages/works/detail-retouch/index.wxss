@import "../../../styles/tokens.wxss";
@import "../../../styles/layout.wxss";
@import "../../../styles/page.wxss";

.detail-retouch-page {
  min-height: 100%;
  padding: 20rpx 24rpx 36rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fffaf3 0%, #fffdf8 48%, #fdf7ef 100%);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.scope-banner,
.editor-preview-card,
.part-panel,
.compare-panel,
.tool-panel,
.tips-card {
  background: rgba(255, 253, 248, 0.96);
  border: 1rpx solid rgba(234, 220, 203, 0.84);
  box-shadow: 0 12rpx 28rpx rgba(95, 72, 48, 0.07);
}

.scope-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border-color: rgba(214, 160, 82, 0.22);
  border-radius: 18rpx;
  background: rgba(255, 248, 234, 0.9);
}

.scope-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(255, 182, 86, 0.18);
  color: #b97920;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
  flex-shrink: 0;
}

.scope-text {
  flex: 1;
  min-width: 0;
  color: #7a603c;
  font-size: 24rpx;
  line-height: 1.45;
}

.editor-section {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.editor-preview-card,
.part-panel,
.compare-panel,
.tool-panel {
  border-radius: 28rpx;
}

.editor-preview-card {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 16rpx;
}

.pet-preview-image {
  width: 100%;
  height: 430rpx;
  border-radius: 26rpx;
  background: #f7eadb;
}

.floating-tool {
  position: absolute;
  top: 28rpx;
  min-width: 86rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.95);
  color: #4d8738;
  box-shadow: 0 10rpx 20rpx rgba(88, 63, 33, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
}

.rotate-tool {
  left: 28rpx;
}

.zoom-tool {
  right: 28rpx;
  min-width: 52rpx;
  padding: 0;
  font-size: 30rpx;
}

.focus-ring {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  border: 4rpx dashed rgba(76, 123, 49, 0.68);
  background: rgba(255, 255, 255, 0.12);
  box-shadow: 0 0 0 8rpx rgba(76, 123, 49, 0.08);
}

.focus-ring-tail {
  right: 40rpx;
  bottom: 86rpx;
}

.focus-ring-ear {
  right: 182rpx;
  top: 88rpx;
}

.focus-ring-chest {
  left: 176rpx;
  bottom: 126rpx;
}

.focus-ring-back {
  right: 134rpx;
  top: 214rpx;
}

.part-panel {
  width: 188rpx;
  padding: 18rpx 14rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.panel-title {
  font-size: 30rpx;
  line-height: 1.32;
  font-weight: 700;
  color: var(--text-primary);
}

.part-item {
  margin-top: 14rpx;
  padding: 10rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(233, 223, 208, 0.82);
  display: grid;
  grid-template-columns: 56rpx 1fr 20rpx;
  gap: 12rpx;
  align-items: center;
  background: rgba(255, 253, 248, 0.98);
}

.part-item.is-active {
  background: rgba(239, 247, 236, 0.98);
  border-color: rgba(77, 135, 56, 0.5);
  box-shadow: 0 8rpx 16rpx rgba(77, 135, 56, 0.1);
}

.part-thumb {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #f7eadb;
}

.part-name {
  font-size: 28rpx;
  line-height: 1.35;
  color: var(--text-primary);
}

.part-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: var(--text-secondary);
  text-align: right;
}

.compare-panel,
.tool-panel {
  padding: 22rpx 22rpx 24rpx;
  box-sizing: border-box;
}

.compare-grid {
  position: relative;
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.compare-image-wrap {
  position: relative;
}

.compare-image {
  width: 100%;
  height: 206rpx;
  border-radius: 22rpx;
  background: #f7eadb;
}

.compare-label {
  position: absolute;
  top: 14rpx;
  left: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.92);
  color: #5d5347;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}

.compare-divider-button {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 46rpx;
  height: 46rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.96);
  color: #6c6256;
  box-shadow: 0 8rpx 16rpx rgba(88, 63, 33, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}

.tool-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tool-row {
  display: grid;
  grid-template-columns: 112rpx 1fr;
  gap: 18rpx;
  align-items: center;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(233, 223, 208, 0.74);
}

.tool-row:first-of-type {
  padding-top: 0;
  border-top: none;
}

.tool-label {
  color: #3d352c;
  font-size: 28rpx;
  line-height: 1.4;
}

.color-strip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.color-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.color-dot.is-light {
  border-color: rgba(214, 205, 192, 0.92);
}

.color-dot.is-active {
  border-color: #4d8738;
  box-shadow: 0 0 0 6rpx rgba(77, 135, 56, 0.14);
}

.more-color {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 78rpx;
}

.color-wheel {
  width: 46rpx;
  height: 46rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff5a5a, #ffb34d, #64b55f, #4f8cff, #bb65ff);
}

.more-color-text {
  color: #6e6251;
  font-size: 20rpx;
  line-height: 1.3;
  text-align: center;
}

.brush-row {
  grid-template-columns: 112rpx 1fr 62rpx;
}

.brush-slider {
  margin: 0;
}

.brush-size-text {
  text-align: right;
  color: #6e6251;
  font-size: 24rpx;
}

.action-tool-row {
  align-items: start;
}

.tool-action-list {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
}

.tool-action {
  min-height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #5d5347;
  background: transparent;
}

.tool-action.is-active {
  background: linear-gradient(180deg, #5a963e 0%, #3f7b2c 100%);
  color: #fff;
  box-shadow: 0 10rpx 20rpx rgba(61, 123, 44, 0.22);
}

.tool-icon {
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
}

.tool-name {
  font-size: 21rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.bottom-actions {
  display: grid;
  grid-template-columns: 0.82fr 1.18fr;
  gap: 22rpx;
  margin-top: 4rpx;
}

.save-status {
  grid-column: 1 / -1;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(214, 160, 82, 0.22);
  background: rgba(255, 248, 234, 0.9);
}

.save-status-loading {
  background: rgba(239, 247, 236, 0.96);
  border-color: rgba(77, 135, 56, 0.24);
}

.save-status-failed {
  background: rgba(255, 248, 234, 0.94);
  border-color: rgba(214, 160, 82, 0.28);
}

.save-status-text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #7a603c;
}

.secondary-retouch-button,
.primary-retouch-button {
  height: 92rpx;
  border-radius: 999rpx;
  padding: 0;
  margin: 0;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.secondary-retouch-button::after,
.primary-retouch-button::after {
  border: none;
}

.secondary-retouch-button {
  border: 2rpx solid rgba(69, 128, 45, 0.38);
  background: rgba(255, 253, 248, 0.95);
  color: #4d8738;
}

.primary-retouch-button {
  flex-direction: column;
  gap: 4rpx;
  background: linear-gradient(180deg, #5a963e 0%, #3f7c2d 100%);
  color: #fff;
  box-shadow: 0 16rpx 30rpx rgba(61, 123, 44, 0.24);
}

.primary-main {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.1;
}

.primary-sub {
  font-size: 21rpx;
  font-weight: 500;
  opacity: 0.88;
  line-height: 1.1;
}

.tips-card {
  display: grid;
  grid-template-columns: 42rpx 1fr 28rpx;
  gap: 10rpx;
  align-items: center;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
}

.tips-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 182, 86, 0.18);
  color: #b97920;
  font-size: 20rpx;
  line-height: 1;
}

.tips-text {
  color: #766b5b;
  font-size: 24rpx;
  line-height: 1.4;
}

.tips-arrow {
  color: #a79b8a;
  font-size: 34rpx;
  line-height: 1;
}
