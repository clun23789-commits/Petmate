@import "../../../styles/tokens.wxss";
@import "../../../styles/layout.wxss";
@import "../../../styles/page.wxss";

.start-create-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 24rpx;
}

.start-hero {
  position: relative;
  min-height: 560rpx;
  padding-top: 10rpx;
}

.hero-copy {
  position: relative;
  z-index: 3;
  padding-right: 302rpx;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.22;
  color: var(--text-primary);
}

.hero-subtitle {
  display: block;
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.hero-visual {
  position: relative;
  min-height: 360rpx;
  margin-top: 26rpx;
}

.transform-strip {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-right: 238rpx;
}

.hero-thumb {
  position: relative;
  width: 170rpx;
  height: 170rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff1df 0%, #ebd7be 100%);
  box-shadow: 0 16rpx 34rpx rgba(136, 97, 53, 0.1);
}

.thumb-photo {
  transform: translateY(4rpx);
}

.thumb-model {
  transform: translateY(-8rpx);
}

.thumb-image {
  width: 100%;
  height: 100%;
}

.wire-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(60deg, transparent 0, transparent 22%, rgba(255, 255, 255, 0.62) 22%, rgba(255, 255, 255, 0.62) 23%, transparent 23%, transparent 44%, rgba(255, 255, 255, 0.58) 44%, rgba(255, 255, 255, 0.58) 45%, transparent 45%, transparent 66%, rgba(255, 255, 255, 0.52) 66%, rgba(255, 255, 255, 0.52) 67%, transparent 67%),
    linear-gradient(120deg, transparent 0, transparent 26%, rgba(255, 255, 255, 0.55) 26%, rgba(255, 255, 255, 0.55) 27%, transparent 27%, transparent 52%, rgba(255, 255, 255, 0.48) 52%, rgba(255, 255, 255, 0.48) 53%, transparent 53%, transparent 78%, rgba(255, 255, 255, 0.42) 78%, rgba(255, 255, 255, 0.42) 79%, transparent 79%);
  opacity: 0.88;
}

.wire-star {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  box-shadow: 0 0 0 6rpx rgba(255, 244, 223, 0.2);
}

.wire-star-a {
  top: 20rpx;
  right: 26rpx;
}

.wire-star-b {
  right: 18rpx;
  bottom: 24rpx;
  width: 10rpx;
  height: 10rpx;
}

.star-line {
  position: absolute;
  left: 50%;
  top: 50%;
  background: rgba(255, 245, 224, 0.95);
  transform: translate(-50%, -50%);
  border-radius: 999rpx;
}

.star-line-horizontal {
  width: 100%;
  height: 4rpx;
}

.star-line-vertical {
  width: 4rpx;
  height: 100%;
}

.hero-arrow {
  color: rgba(212, 160, 102, 0.92);
  font-size: 72rpx;
  font-weight: 300;
  line-height: 1;
}

.hero-arrow-second {
  margin-left: -8rpx;
}

.hero-pet {
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 372rpx;
  height: 410rpx;
  z-index: 2;
}

.sparkle {
  position: absolute;
  border-radius: 8rpx;
}

.sparkle-a {
  top: 76rpx;
  right: 298rpx;
  width: 24rpx;
  height: 24rpx;
}

.sparkle-b {
  top: 188rpx;
  right: 4rpx;
  width: 18rpx;
  height: 18rpx;
}

.sparkle-c {
  top: 140rpx;
  right: 72rpx;
  width: 12rpx;
  height: 12rpx;
  opacity: 0.72;
}

.sparkle-arm {
  position: absolute;
  left: 50%;
  top: 50%;
  background: rgba(255, 224, 168, 0.78);
  transform: translate(-50%, -50%);
  border-radius: 999rpx;
}

.sparkle-arm-horizontal {
  width: 100%;
  height: 4rpx;
}

.sparkle-arm-vertical {
  width: 4rpx;
  height: 100%;
}

.flow-card {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  padding: 30rpx 18rpx 24rpx;
  border-radius: 34rpx;
  background: rgba(255, 253, 248, 0.96);
  border: 1rpx solid rgba(234, 220, 203, 0.92);
  box-shadow: 0 14rpx 34rpx rgba(95, 72, 48, 0.06);
}

.flow-step {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  text-align: center;
}

.step-number {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8b33 0%, #ff6f28 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 20rpx rgba(241, 138, 49, 0.18);
}

.step-icon-wrap {
  width: 118rpx;
  height: 118rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #fffaf1 0%, #fff5e3 56%, #ffedd4 100%);
}

.step-icon {
  color: #bc9a73;
  font-size: 34rpx;
  font-weight: 700;
}

.step-title {
  color: var(--text-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.42;
}

.step-desc {
  color: var(--text-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.step-connector {
  position: absolute;
  top: 78rpx;
  right: -16rpx;
  width: 34rpx;
  border-top: 4rpx dotted rgba(241, 138, 49, 0.26);
}

.support-card {
  position: relative;
  min-height: 180rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 238rpx 26rpx 24rpx;
  border-radius: 32rpx;
  background: rgba(250, 255, 245, 0.96);
  border: 1rpx solid rgba(93, 150, 100, 0.18);
  box-shadow: 0 14rpx 32rpx rgba(93, 150, 100, 0.06);
  overflow: hidden;
}

.support-check {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #d8efc6 0%, #bde39f 100%);
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  box-shadow: inset 0 6rpx 10rpx rgba(255, 255, 255, 0.4);
}

.support-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.support-title {
  color: #2f3a24;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.support-desc {
  color: #6a7a5e;
  font-size: 24rpx;
  line-height: 1.65;
}

.support-pets {
  position: absolute;
  right: 8rpx;
  bottom: -2rpx;
  width: 232rpx;
  height: 186rpx;
}

.support-cat {
  position: absolute;
  left: 4rpx;
  bottom: 0;
  width: 118rpx;
  height: 150rpx;
  z-index: 2;
}

.support-dog {
  position: absolute;
  right: 6rpx;
  bottom: 0;
  width: 136rpx;
  height: 162rpx;
  z-index: 2;
}

.support-leaf {
  position: absolute;
  background: linear-gradient(135deg, rgba(202, 230, 167, 0.88) 0%, rgba(169, 211, 121, 0.68) 100%);
  border-radius: 100% 0 100% 0;
  transform: rotate(20deg);
  opacity: 0.7;
}

.leaf-a {
  right: 12rpx;
  bottom: 30rpx;
  width: 28rpx;
  height: 54rpx;
}

.leaf-b {
  right: 34rpx;
  bottom: 8rpx;
  width: 22rpx;
  height: 42rpx;
}

.trial-card {
  position: relative;
  display: flex;
  gap: 24rpx;
  padding: 30rpx 196rpx 30rpx 24rpx;
  border-radius: 34rpx;
  background: rgba(255, 248, 239, 0.97);
  border: 1rpx solid rgba(241, 138, 49, 0.15);
  box-shadow: 0 14rpx 34rpx rgba(157, 104, 45, 0.07);
  overflow: hidden;
}

.trial-icon {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff4df 0%, #ffe6bf 100%);
  color: #ff7b2c;
  font-size: 38rpx;
  font-weight: 700;
}

.trial-copy {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.trial-title {
  color: #3b2b1e;
  font-size: 30rpx;
  font-weight: 800;
}

.rights-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.rights-bullet {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-top: 4rpx;
  background: rgba(255, 173, 88, 0.2);
  color: #f08a31;
  font-size: 18rpx;
  font-weight: 700;
}

.rights-text {
  color: #6a5646;
  font-size: 24rpx;
  line-height: 1.6;
}

.trial-tv {
  position: absolute;
  right: 26rpx;
  bottom: 24rpx;
  width: 132rpx;
  height: 116rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ff9a3d 0%, #ffbe63 100%);
  box-shadow: 0 18rpx 30rpx rgba(241, 138, 49, 0.18);
}

.tv-antenna {
  position: absolute;
  top: -14rpx;
  width: 6rpx;
  height: 20rpx;
  background: #f7b25e;
  border-radius: 999rpx;
}

.tv-antenna-left {
  left: 44rpx;
  transform: rotate(-26deg);
}

.tv-antenna-right {
  right: 44rpx;
  transform: rotate(26deg);
}

.tv-screen {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  bottom: 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 249, 242, 0.82);
}

.tv-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-40%, -50%);
  width: 0;
  height: 0;
  border-left: 30rpx solid #ff9a3d;
  border-top: 20rpx solid transparent;
  border-bottom: 20rpx solid transparent;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 4rpx;
}

.action-button {
  width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  overflow: hidden;
}

.action-button::after {
  border: 0;
}

.unlock-button {
  min-height: 112rpx;
  background: linear-gradient(135deg, #ff7b2c 0%, #ff6821 100%);
  box-shadow: 0 18rpx 34rpx rgba(241, 138, 49, 0.22);
}

.template-button {
  min-height: 110rpx;
  background: rgba(255, 253, 249, 0.94);
  border: 1rpx solid rgba(234, 209, 186, 0.96);
}

.action-copy {
  min-height: inherit;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.action-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.action-title-dark {
  color: var(--text-primary);
}

.action-subtitle {
  color: #a08f80;
  font-size: 24rpx;
  line-height: 1.45;
}

.action-subtitle-light {
  color: rgba(255, 255, 255, 0.86);
}

.privacy-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 4rpx 18rpx 0;
  color: var(--text-muted);
  text-align: center;
}

.privacy-icon {
  font-size: 24rpx;
  color: #aa9a8a;
}

.privacy-text {
  font-size: 22rpx;
  line-height: 1.6;
}

.dev-note {
  margin-top: 4rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 245, 0.92);
  border: 1rpx dashed rgba(219, 198, 177, 0.92);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.dev-note-title {
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 700;
}

.dev-note-text {
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
}
