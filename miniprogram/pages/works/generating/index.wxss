@import "../../../styles/tokens.wxss";
@import "../../../styles/layout.wxss";
@import "../../../styles/page.wxss";

.generating-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: 32rpx;
}

.hero-card,
.progress-card,
.trust-card,
.quota-card,
.generation-status-card,
.failure-recovery-card {
  background: var(--color-bg-card-strong);
  border: 1rpx solid var(--color-border-normal);
  box-shadow: var(--shadow-card);
  border-radius: 34rpx;
  box-sizing: border-box;
}

.hero-card {
  position: relative;
  overflow: hidden;
  min-height: 460rpx;
  padding: 42rpx 36rpx 34rpx;
  background: var(--gradient-brand-soft);
  border-color: rgba(238, 216, 190, 0.86);
  box-shadow: 0 18rpx 44rpx rgba(129, 93, 53, 0.1);
}

.hero-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-title {
  font-size: 46rpx;
  line-height: 1.22;
  font-weight: 800;
  color: var(--text-primary);
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.transform-stage {
  position: relative;
  z-index: 2;
  margin-top: 62rpx;
  display: grid;
  grid-template-columns: 150rpx 22rpx 150rpx 22rpx 1fr;
  align-items: end;
  gap: 10rpx;
}

.source-card {
  width: 150rpx;
  height: 150rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 24rpx rgba(122, 87, 50, 0.1);
}

.source-image {
  width: 100%;
  height: 100%;
}

.mesh-card {
  position: relative;
}

.mesh-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(60deg, transparent 0, transparent 18%, rgba(255, 255, 255, 0.62) 18%, rgba(255, 255, 255, 0.62) 19%, transparent 19%, transparent 38%, rgba(255, 255, 255, 0.58) 38%, rgba(255, 255, 255, 0.58) 39%, transparent 39%, transparent 58%, rgba(255, 255, 255, 0.54) 58%, rgba(255, 255, 255, 0.54) 59%, transparent 59%, transparent 78%, rgba(255, 255, 255, 0.5) 78%, rgba(255, 255, 255, 0.5) 79%, transparent 79%),
    linear-gradient(120deg, transparent 0, transparent 22%, rgba(255, 255, 255, 0.55) 22%, rgba(255, 255, 255, 0.55) 23%, transparent 23%, transparent 46%, rgba(255, 255, 255, 0.5) 46%, rgba(255, 255, 255, 0.5) 47%, transparent 47%, transparent 70%, rgba(255, 255, 255, 0.46) 70%, rgba(255, 255, 255, 0.46) 71%, transparent 71%);
  opacity: 0.86;
}

.stage-arrow {
  padding-bottom: 54rpx;
  font-size: 64rpx;
  line-height: 1;
  color: var(--color-text-secondary);
  font-weight: 500;
  text-align: center;
}

.final-pet-stage {
  position: relative;
  height: 248rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.final-pet-image {
  position: relative;
  z-index: 2;
  width: 216rpx;
  height: 248rpx;
}

.pet-platform {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 4rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 247, 229, 0.96), rgba(255, 200, 107, 0.45));
  border: 2rpx solid rgba(244, 178, 73, 0.42);
}

.hero-glow {
  position: absolute;
  right: 100rpx;
  bottom: 106rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 252, 244, 0.94) 0%, rgba(255, 241, 213, 0.58) 56%, transparent 100%);
}

.sparkle {
  position: absolute;
  z-index: 1;
  color: rgba(246, 188, 74, 0.9);
  font-size: 30rpx;
  line-height: 1;
}

.sparkle-a {
  right: 114rpx;
  top: 116rpx;
}

.sparkle-b {
  right: 60rpx;
  top: 170rpx;
  font-size: 22rpx;
}

.sparkle-c {
  right: 250rpx;
  top: 136rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
}

.leaf {
  position: absolute;
  z-index: 1;
  background: linear-gradient(180deg, rgba(231, 241, 214, 0.86) 0%, rgba(208, 228, 185, 0.64) 100%);
  border-radius: 100% 0 100% 0;
}

.leaf-a {
  right: 24rpx;
  top: 214rpx;
  width: 48rpx;
  height: 112rpx;
  transform: rotate(14deg);
}

.leaf-b {
  right: 76rpx;
  top: 258rpx;
  width: 30rpx;
  height: 72rpx;
  transform: rotate(-18deg);
}

.leaf-c {
  right: 206rpx;
  bottom: 56rpx;
  width: 20rpx;
  height: 48rpx;
  opacity: 0.54;
}

.progress-card {
  padding: 38rpx 34rpx 34rpx;
}

.generation-status-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx 26rpx;
}

.generation-status-card-brand {
  border-color: var(--color-border-brand);
  background: var(--color-brand-softer);
}

.generation-status-card-success {
  border-color: var(--color-border-success);
  background: var(--color-bg-success);
}

.generation-status-card-warning {
  border-color: var(--color-border-warning);
  background: var(--color-bg-warning);
}

.generation-status-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.generation-status-icon {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: var(--color-bg-card-strong);
  color: var(--color-text-brand);
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: var(--shadow-card-soft);
}

.generation-status-card-success .generation-status-icon {
  color: var(--color-text-success);
}

.generation-status-card-warning .generation-status-icon {
  color: var(--color-text-warning);
}

.generation-status-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.generation-status-title {
  color: var(--color-text-primary);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.38;
}

.generation-status-desc {
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.55;
}

.generation-progress-meter {
  height: 16rpx;
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--color-border-light);
}

.generation-progress-bar {
  height: 100%;
  min-width: 8%;
  border-radius: var(--radius-pill);
  background: var(--gradient-brand-button);
}

.generation-status-card-success .generation-progress-bar {
  background: var(--color-success);
}

.generation-status-card-warning .generation-progress-bar {
  background: var(--color-warning);
}

.generation-status-hint {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.progress-heading {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.progress-track {
  margin-top: 34rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.progress-step {
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.step-icon-wrap {
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(246, 239, 230, 0.92);
  border: 1rpx solid rgba(232, 216, 196, 0.86);
  color: rgba(139, 112, 83, 0.68);
}

.progress-step.is-active .step-icon-wrap,
.progress-step.is-done .step-icon-wrap {
  background: var(--gradient-brand-soft);
  color: var(--brand);
  border-color: rgba(255, 189, 92, 0.64);
  box-shadow: 0 16rpx 30rpx rgba(241, 138, 49, 0.22);
}

.step-icon {
  font-size: 42rpx;
  font-weight: 700;
}

.step-title {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 600;
  color: var(--text-primary);
}

.step-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: var(--text-secondary);
}

.step-connector {
  flex: 1;
  height: 2rpx;
  margin-top: 52rpx;
  border-top: 4rpx dashed rgba(226, 205, 181, 0.9);
}

.step-connector.is-done {
  border-top-color: rgba(255, 176, 87, 0.72);
}

.trust-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 24rpx;
}

.trust-card-main {
  overflow: hidden;
  padding-right: 220rpx;
  background: var(--color-bg-success);
}

.trust-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(221, 240, 202, 0.96), rgba(202, 229, 174, 0.92));
  color: var(--success-strong);
  font-size: 34rpx;
  font-weight: 700;
}

.trust-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.trust-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.trust-desc {
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
}

.trust-decor {
  position: absolute;
  right: 10rpx;
  bottom: 0;
  width: 198rpx;
  height: 158rpx;
}

.trust-pet {
  position: absolute;
  right: 24rpx;
  bottom: 0;
  width: 124rpx;
  height: 150rpx;
}

.trust-leaf {
  position: absolute;
  background: linear-gradient(180deg, rgba(219, 238, 196, 0.76) 0%, rgba(197, 225, 167, 0.52) 100%);
  border-radius: 100% 0 100% 0;
}

.trust-leaf-a {
  right: 0;
  bottom: 22rpx;
  width: 28rpx;
  height: 62rpx;
  transform: rotate(16deg);
}

.trust-leaf-b {
  right: 44rpx;
  bottom: 18rpx;
  width: 18rpx;
  height: 44rpx;
  transform: rotate(-12deg);
}

.quota-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 24rpx;
  border-style: dashed;
  border-color: rgba(223, 216, 194, 0.92);
  background: var(--color-bg-card-strong);
}

.quota-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(228, 242, 208, 0.96), rgba(210, 232, 182, 0.92));
  color: var(--color-text-success);
  font-size: 34rpx;
  font-weight: 700;
}

.quota-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.quota-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.quota-desc {
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.quota-status {
  min-width: 112rpx;
  height: 58rpx;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(229, 241, 212, 0.9);
  color: var(--color-text-success);
  font-size: 26rpx;
  font-weight: 700;
}

.failure-recovery-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-color: var(--color-border-warning);
  background: var(--color-bg-warning);
}

.failure-recovery-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 22rpx;
  background: var(--color-bg-card-strong);
  color: var(--color-text-warning);
  font-size: 26rpx;
  font-weight: 800;
}

.failure-recovery-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.failure-recovery-title {
  color: var(--color-text-primary);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.failure-recovery-desc {
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.failure-recovery-button {
  width: 180rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: var(--radius-pill);
  background: var(--color-bg-card-strong);
  border: 1rpx solid var(--color-border-warning);
  color: var(--color-text-warning);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.failure-recovery-button::after {
  border: 0;
}

.back-work-button {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(224, 206, 184, 0.96);
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 16rpx 34rpx rgba(124, 97, 62, 0.06);
}

.back-work-button::after {
  border: none;
}

.back-home-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.icon-roof {
  position: absolute;
  left: 6rpx;
  top: -2rpx;
  width: 30rpx;
  height: 30rpx;
  border-left: 5rpx solid var(--color-text-primary);
  border-top: 5rpx solid var(--color-text-primary);
  transform: rotate(45deg);
  box-sizing: border-box;
}

.icon-house {
  position: absolute;
  left: 10rpx;
  bottom: 2rpx;
  width: 24rpx;
  height: 20rpx;
  border: 5rpx solid var(--color-text-primary);
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
  box-sizing: border-box;
}

.back-work-text {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.estimate-text {
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}
