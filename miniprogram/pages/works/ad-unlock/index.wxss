@import "../../../styles/tokens.wxss";
@import "../../../styles/layout.wxss";
@import "../../../styles/page.wxss";

.unlock-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding-bottom: var(--space-xl);
}

.hero-card,
.source-card,
.benefit-card,
.rule-card,
.boundary-card,
.recovery-tip {
  box-sizing: border-box;
  border: 1rpx solid var(--color-border-normal);
  border-radius: var(--radius-xl);
  background: var(--color-bg-card-strong);
  box-shadow: var(--shadow-card-soft);
}

.hero-card {
  position: relative;
  min-height: 320rpx;
  display: flex;
  padding: var(--space-lg) var(--space-md);
  overflow: hidden;
  background: var(--gradient-success-card);
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 400rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-sm);
}

.hero-title {
  color: var(--color-text-primary);
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
}

.hero-desc {
  color: var(--color-text-secondary);
  font-size: var(--font-size-md);
  line-height: 1.7;
}

.hero-pets {
  position: absolute;
  right: var(--space-sm);
  bottom: 0;
  width: 282rpx;
  height: 244rpx;
}

.hero-glow {
  position: absolute;
  right: 6rpx;
  bottom: 22rpx;
  width: 220rpx;
  height: 86rpx;
  border-radius: 50%;
  background: var(--color-success-soft);
}

.hero-pet {
  position: absolute;
  bottom: 0;
}

.hero-pet-main {
  right: 56rpx;
  width: 164rpx;
  height: 206rpx;
}

.hero-pet-sub {
  right: 0;
  width: 120rpx;
  height: 166rpx;
}

.unlock-summary-card,
.ad-action-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-sm);
}

.summary-item {
  min-height: 116rpx;
  padding: 18rpx var(--space-sm);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-border-light);
  background: var(--color-bg-card);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-xs);
}

.summary-item-success {
  background: var(--color-bg-success);
  border-color: var(--color-border-success);
}

.summary-item-warning {
  background: var(--color-bg-warning);
  border-color: var(--color-border-warning);
}

.summary-label {
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
  line-height: 1.35;
}

.summary-value {
  color: var(--color-text-primary);
  font-size: var(--font-size-md);
  font-weight: 800;
  line-height: 1.35;
}

.summary-item-success .summary-value {
  color: var(--color-text-success);
}

.summary-item-warning .summary-value {
  color: var(--color-text-warning);
}

.ad-action-card {
  padding: var(--space-md);
}

.ad-action-copy {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.ad-action-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-xl);
  font-weight: 800;
  line-height: 1.35;
}

.ad-action-desc {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.6;
}

.ad-action-hint {
  color: var(--color-text-brand);
  font-size: var(--font-size-xs);
  line-height: 1.5;
}

.ad-cancel {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
  line-height: 1.5;
  text-align: center;
}

.boundary-card,
.recovery-tip {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: 22rpx var(--space-md);
}

.boundary-card {
  background: var(--color-bg-warning);
  border-color: var(--color-border-warning);
}

.boundary-icon,
.recovery-icon,
.benefit-note-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: var(--radius-pill);
  font-weight: 800;
  line-height: 1;
}

.boundary-icon {
  width: 58rpx;
  height: 58rpx;
  background: var(--color-warning-soft);
  color: var(--color-text-warning);
  font-size: var(--font-size-xs);
}

.boundary-copy,
.recovery-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xxs);
}

.boundary-title,
.recovery-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-md);
  font-weight: 800;
  line-height: 1.4;
}

.boundary-desc,
.recovery-desc {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.58;
}

.recovery-tip {
  background: var(--color-bg-success);
  border-color: var(--color-border-success);
}

.recovery-icon {
  width: 50rpx;
  height: 50rpx;
  background: var(--color-success-soft);
  color: var(--color-text-success);
  font-size: var(--font-size-xs);
}

.recovery-arrow {
  color: var(--color-text-success);
  font-size: 36rpx;
  line-height: 1;
}

.source-card,
.benefit-card,
.rule-card {
  display: flex;
  flex-direction: column;
  padding: var(--space-md);
}

.source-card {
  gap: var(--space-sm);
}

.source-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-lg);
  font-weight: 800;
}

.source-chip-row {
  display: flex;
  gap: var(--space-sm);
  flex-wrap: wrap;
}

.source-chip {
  min-height: 60rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  padding: 0 var(--space-md);
  border-radius: var(--radius-pill);
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  font-weight: 700;
  border: 1rpx solid var(--color-border-light);
}

.source-chip-icon {
  font-size: var(--font-size-xs);
}

.source-chip.is-active {
  background: var(--color-bg-success);
  color: var(--color-text-success);
  border-color: var(--color-border-success);
}

.benefit-card,
.rule-card {
  gap: var(--space-md);
}

.benefit-section-title,
.rule-section-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-xl);
  font-weight: 800;
}

.benefit-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-sm);
}

.benefit-item {
  min-height: 210rpx;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: var(--color-bg-card-soft);
  border: 1rpx solid var(--color-border-light);
  box-sizing: border-box;
}

.benefit-icon,
.rule-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: var(--radius-pill);
  background: var(--color-success-soft);
  color: var(--color-text-success);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xs);
  font-weight: 800;
}

.benefit-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  font-weight: 800;
  line-height: 1.45;
}

.benefit-desc {
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
  line-height: 1.58;
}

.benefit-note {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  padding: 18rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-success);
  border: 1rpx solid var(--color-border-success);
}

.benefit-note-icon {
  width: 34rpx;
  height: 34rpx;
  background: var(--color-bg-card-strong);
  color: var(--color-text-success);
  font-size: var(--font-size-xs);
}

.benefit-note-text {
  flex: 1;
  color: var(--color-text-success);
  font-size: var(--font-size-sm);
  line-height: 1.6;
}

.rule-list {
  display: flex;
  flex-direction: column;
}

.rule-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.rule-item.is-last {
  border-bottom: none;
}

.rule-icon {
  flex-shrink: 0;
}

.rule-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.rule-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-md);
  font-weight: 800;
  line-height: 1.4;
}

.rule-desc {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: 1.65;
}

.rule-arrow {
  color: var(--color-text-tertiary);
  font-size: 44rpx;
  line-height: 1;
  flex-shrink: 0;
}
