@import "../../../styles/layout.wxss";
@import "../../../styles/page.wxss";

.template-demo-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(255, 245, 223, 0.82) 0, rgba(255, 245, 223, 0) 28%),
    linear-gradient(180deg, #fffaf3 0%, #fbf4ea 100%);
  color: #352820;
  box-sizing: border-box;
}

.template-demo-page button::after {
  border: none;
}

.template-content,
.template-loading {
  padding: 0 26rpx;
  box-sizing: border-box;
}

.template-content {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.template-loading {
  padding-top: 12rpx;
}

.loading-card {
  padding: 30rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(236, 222, 201, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(95, 72, 48, 0.07);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.official-notice-card,
.model-stage-card,
.about-template-card,
.warm-tip-card {
  border-radius: 30rpx;
  box-shadow: 0 12rpx 32rpx rgba(72, 45, 22, 0.06);
  box-sizing: border-box;
}

.official-notice-card {
  padding: 28rpx 30rpx;
  background: linear-gradient(180deg, #fff9ea 0%, #fff7e2 100%);
  border: 2rpx solid rgba(241, 208, 139, 0.72);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.notice-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.notice-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ffc955 0%, #ffb431 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.notice-icon {
  font-size: 22rpx;
  color: #ffffff;
  line-height: 1;
}

.notice-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2f2418;
  line-height: 1.2;
}

.notice-text,
.notice-warning {
  font-size: 30rpx;
  line-height: 1.7;
}

.notice-text {
  color: #594d42;
}

.notice-warning {
  color: #ea7a26;
  font-weight: 600;
}

.model-stage-card {
  position: relative;
  min-height: 760rpx;
  padding: 24rpx;
  background: linear-gradient(180deg, #fff4e5 0%, #fdf0e4 100%);
  overflow: hidden;
}

.stage-soft-glow {
  position: absolute;
  left: 50%;
  top: 72rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(255, 252, 246, 0.94) 0%, rgba(255, 252, 246, 0) 72%);
}

.gesture-tools {
  position: absolute;
  left: 24rpx;
  top: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  z-index: 3;
}

.gesture-tool {
  width: 122rpx;
  min-height: 122rpx;
  padding: 0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(68, 45, 24, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.gesture-icon {
  font-size: 38rpx;
  line-height: 1;
  color: #4f3a2b;
}

.gesture-text {
  font-size: 28rpx;
  line-height: 1.2;
  color: #4f3a2b;
}

.model-main-area {
  position: relative;
  min-height: 700rpx;
  padding: 18rpx 124rpx 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.model-stage-floor {
  position: absolute;
  left: 50%;
  bottom: 154rpx;
  width: 420rpx;
  height: 94rpx;
  border-radius: 50%;
  transform: translateX(-50%);
  background: radial-gradient(circle at 50% 36%, rgba(255, 251, 244, 0.96), rgba(241, 218, 182, 0.8));
}

.model-hero-image {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 600rpx;
}

.preview-rail {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  z-index: 3;
}

.preview-thumb {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(230, 220, 206, 0.9);
  box-sizing: border-box;
  overflow: hidden;
}

.preview-thumb.is-active {
  border-width: 4rpx;
  border-color: #ff7a1a;
  box-shadow: 0 10rpx 20rpx rgba(255, 122, 26, 0.14);
}

.preview-thumb-image {
  width: 100%;
  height: 100%;
}

.preview-thumb-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(53, 40, 32, 0.08), rgba(53, 40, 32, 0.2));
}

.preview-play-button {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-play-icon {
  margin-left: 4rpx;
  font-size: 28rpx;
  color: #433327;
}

.drag-hint {
  position: absolute;
  left: 50%;
  bottom: 52rpx;
  transform: translateX(-50%);
  max-width: 470rpx;
  padding: 16rpx 34rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  font-size: 28rpx;
  line-height: 1.35;
  color: #4a3529;
  box-shadow: 0 10rpx 24rpx rgba(68, 45, 24, 0.08);
  text-align: center;
  z-index: 3;
  box-sizing: border-box;
}

.stage-dots {
  position: absolute;
  left: 50%;
  bottom: 18rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 3;
}

.stage-dot {
  width: 26rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(199, 191, 181, 0.72);
}

.stage-dot.is-active {
  width: 36rpx;
  background: #ff8b2b;
}

.about-template-card {
  padding: 28rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(236, 222, 201, 0.92);
}

.section-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #ffbf61 0%, #ff9d38 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-icon {
  font-size: 24rpx;
  line-height: 1;
  color: #ffffff;
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #2f2418;
  line-height: 1.2;
}

.about-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
}

.about-item {
  flex: 1;
  min-width: 190rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 4rpx 22rpx 0 0;
  box-sizing: border-box;
}

.about-item.has-divider {
  border-right: 1rpx solid rgba(229, 219, 208, 0.92);
  margin-right: 22rpx;
}

.about-icon {
  font-size: 34rpx;
  line-height: 1;
  color: #f29a34;
}

.about-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #31261a;
}

.about-desc {
  font-size: 28rpx;
  line-height: 1.68;
  color: #594f45;
}

.warm-tip-card {
  padding: 26rpx 28rpx;
  background: linear-gradient(135deg, rgba(240, 242, 255, 0.96) 0%, rgba(245, 238, 255, 0.96) 100%);
  border: 1rpx solid rgba(203, 210, 245, 0.74);
  display: flex;
  align-items: center;
  gap: 20rpx;
  text-align: left;
}

.tip-icon-wrap {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(95, 117, 219, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tip-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #6575d8;
}

.tip-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #2d2651;
}

.tip-text {
  font-size: 28rpx;
  line-height: 1.68;
  color: #4f4a67;
}

.tip-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: #4b4a67;
}

.bottom-safe-space {
  height: calc(196rpx + env(safe-area-inset-bottom));
}

.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 250, 243, 0) 0%, #fffaf3 28%, #fffaf3 100%);
  display: grid;
  grid-template-columns: 0.82fr 1.48fr;
  gap: 20rpx;
  z-index: 20;
  box-sizing: border-box;
}

.secondary-bottom-button,
.primary-bottom-button {
  min-height: 110rpx;
  padding: 0;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.secondary-bottom-button {
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(231, 222, 209, 0.96);
  color: #3f3226;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(72, 45, 22, 0.08);
}

.primary-bottom-button {
  background: linear-gradient(180deg, #ff8e2a 0%, #ff7416 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 32rpx rgba(255, 126, 29, 0.28);
  flex-direction: column;
  gap: 6rpx;
}

.primary-main {
  font-size: 30rpx;
  line-height: 1.22;
  font-weight: 700;
}

.primary-sub {
  font-size: 22rpx;
  line-height: 1.4;
  opacity: 0.94;
}
