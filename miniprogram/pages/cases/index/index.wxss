@import "../../../styles/tokens.wxss";
@import "../../../styles/layout.wxss";
@import "../../../styles/page.wxss";

.case-gallery-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(255, 236, 214, 0.68), transparent 32%),
    linear-gradient(180deg, #fff9f0 0%, #f7f1e7 48%, #f6efe4 100%);
  box-sizing: border-box;
  padding-bottom: calc(132rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.case-gallery-content {
  padding: 18rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.search-entry {
  height: 84rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(234, 220, 203, 0.96);
  box-shadow: 0 10rpx 24rpx rgba(95, 72, 48, 0.04);
}

.search-icon {
  color: #907e6f;
  font-size: 34rpx;
  line-height: 1;
}

.search-placeholder {
  color: #a99a8c;
  font-size: 30rpx;
}

.filter-scroll {
  width: 100%;
  margin: 22rpx 0 24rpx;
}

.filter-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 24rpx;
}

.filter-chip {
  height: 62rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 24rpx;
  white-space: nowrap;
  color: #5e5044;
  font-size: 29rpx;
  font-weight: 600;
  background: rgba(255, 248, 238, 0.92);
  border: 1rpx solid rgba(243, 232, 214, 0.86);
}

.filter-chip.is-active {
  color: #e5791f;
  background:
    linear-gradient(135deg, rgba(255, 233, 197, 0.94) 0%, rgba(255, 248, 239, 0.98) 68%, rgba(255, 231, 203, 0.92) 100%);
  border-color: rgba(252, 206, 144, 0.92);
  box-shadow: 0 10rpx 22rpx rgba(241, 138, 49, 0.08);
}

.sample-hero {
  position: relative;
  min-height: 316rpx;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 82% 42%, rgba(255, 214, 153, 0.78), transparent 38%),
    linear-gradient(135deg, #fff4df 0%, #ffe8c5 100%);
  border: 1rpx solid rgba(232, 202, 165, 0.84);
  box-shadow: 0 18rpx 42rpx rgba(159, 104, 45, 0.12);
  margin-bottom: 28rpx;
}

.sample-copy {
  position: relative;
  z-index: 2;
  padding-right: 262rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.sample-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #3a2a1e;
}

.sample-desc {
  font-size: 25rpx;
  line-height: 1.6;
  color: #6f5b49;
}

.sample-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 8rpx;
}

.sample-primary,
.sample-secondary {
  height: 68rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.sample-primary::after,
.sample-secondary::after {
  border: 0;
}

.sample-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a31 0%, #ff6c22 100%);
  box-shadow: 0 12rpx 24rpx rgba(241, 113, 32, 0.26);
}

.sample-secondary {
  color: #4d3f34;
  background: rgba(255, 253, 248, 0.94);
  border: 1rpx solid rgba(219, 167, 108, 0.72);
}

.sample-pets {
  position: absolute;
  right: 10rpx;
  bottom: -6rpx;
  width: 312rpx;
  height: 278rpx;
}

.sample-dog {
  position: absolute;
  right: 42rpx;
  bottom: 0;
  width: 230rpx;
  height: 252rpx;
}

.sample-cat {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 164rpx;
  height: 196rpx;
}

.case-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.case-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(234, 220, 203, 0.92);
  box-shadow: 0 12rpx 28rpx rgba(95, 72, 48, 0.07);
}

.case-cover {
  position: relative;
  height: 284rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #fff4e6 0%, #ead9bf 100%);
}

.cover-blush {
  background: linear-gradient(135deg, #fff4e6 0%, #ead9bf 100%);
}

.cover-sand {
  background: linear-gradient(135deg, #ffeccf 0%, #ebd3ac 100%);
}

.cover-latte {
  background: linear-gradient(135deg, #fff1dd 0%, #e7d5bc 100%);
}

.cover-warm {
  background: linear-gradient(135deg, #fff0dc 0%, #efdcc0 100%);
}

.cover-honey {
  background: linear-gradient(135deg, #ffe7c8 0%, #e8d0a6 100%);
}

.cover-mist {
  background: linear-gradient(135deg, #fff3e8 0%, #ddd1c1 100%);
}

.case-main-image {
  width: 100%;
  height: 100%;
}

.image-center {
  transform: scale(1.06);
}

.image-lift {
  transform: scale(1.1) translateY(-8rpx);
}

.image-close {
  transform: scale(1.14);
}

.image-right {
  transform: scale(1.08) translateX(10rpx);
}

.image-left {
  transform: scale(1.08) translateX(-10rpx);
}

.image-low {
  transform: scale(1.08) translateY(8rpx);
}

.case-thumb-wrap {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 20rpx rgba(70, 50, 35, 0.18);
  background: rgba(255, 255, 255, 0.52);
}

.case-thumb-wrap.is-video {
  box-shadow: 0 10rpx 24rpx rgba(70, 50, 35, 0.22);
}

.case-thumb {
  width: 100%;
  height: 100%;
}

.thumb-focus {
  transform: scale(1.06);
}

.thumb-wide {
  transform: scale(1.1);
}

.thumb-soft {
  transform: scale(1.02);
}

.thumb-badge {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(47, 38, 31, 0.68);
  color: #fffdf8;
  font-size: 18rpx;
  font-weight: 600;
}

.case-info-row {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
}

.case-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  color: #5e4d3e;
  font-size: 28rpx;
  font-weight: 700;
}

.case-icon {
  font-size: 24rpx;
}

.case-tags {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
  overflow: hidden;
}

.case-tag {
  max-width: 120rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #e9f5dd;
  color: #5d8b3d;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.status-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  align-items: flex-start;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.95);
  border: 1rpx solid rgba(234, 220, 203, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(95, 72, 48, 0.05);
}

.status-card-empty {
  background: rgba(255, 252, 246, 0.96);
}

.status-card-error {
  background: rgba(255, 248, 243, 0.96);
}

.status-title {
  color: #3e2e22;
  font-size: 30rpx;
  font-weight: 700;
}

.status-desc {
  color: #7c6a5d;
  font-size: 25rpx;
  line-height: 1.6;
}

.status-action {
  height: 60rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #f07e25;
  font-size: 24rpx;
  font-weight: 700;
  background: rgba(255, 236, 213, 0.92);
}
