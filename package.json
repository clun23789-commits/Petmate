{
  "name": "petmate-mini",
  "version": "1.5.0",
  "private": true,
  "description": "Petmate 微信小程序开发版",
  "scripts": {
    "env:development": "node ./tools/sync-env-config.mjs --env=development",
    "env:staging": "node ./tools/sync-env-config.mjs --env=staging",
    "env:production": "node ./tools/sync-env-config.mjs --env=production",
    "build:miniprogram": "node ./tools/build-miniprogram.mjs",
    "check:structure": "node ./tools/check-structure.mjs",
    "check:page-structure": "node ./tools/check-page-structure.mjs",
    "check:product": "node ./tools/check-product-boundaries.mjs",
    "check:mock-boundary": "node ./tools/check-mock-boundary.mjs",
    "check:auth": "node ./tools/check-auth-contract.mjs",
    "check:runtime-config": "node ./tools/check-runtime-config.mjs",
    "check:generation-task": "node ./tools/check-generation-task-contract.mjs",
    "test:generation-idempotency": "node --test tests/generation-idempotency/*.test.mjs",
    "test:save-work": "node --test tests/save-work/*.test.mjs",
    "check:save-work": "node ./tools/check-save-work-contract.mjs",
    "test:optimize-quota": "node --test tests/optimize-quota/*.test.mjs",
    "check:optimize-quota-transaction": "node ./tools/check-optimize-quota-transaction-contract.mjs",
    "test:ad-reward": "node --test tests/ad-reward/*.test.mjs",
    "check:ad-reward-settlement": "node ./tools/check-ad-reward-settlement-contract.mjs",
    "test:payment-security": "node --test tests/payment/*.test.mjs",
    "check:production-readiness": "node ./tools/check-production-readiness.mjs",
    "check": "npm run check:structure && npm run check:page-structure && npm run check:product && npm run check:mock-boundary && npm run check:auth && npm run check:runtime-config && npm run check:generation-task && npm run test:generation-idempotency && npm run test:save-work && npm run check:save-work && npm run test:optimize-quota && npm run check:optimize-quota-transaction && npm run test:ad-reward && npm run check:ad-reward-settlement && npm run test:payment-security && npm run build:miniprogram",
    "release:precheck": "npm run check && npm run check:production-readiness"
  }
}
